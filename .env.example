
# SQL SERVER
DB_SERVER=ENVIEO\NVLNVL
DB_NAME=QuanLyDaoTao
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Chi dung SQL Server Authentication khi can
DB_USER=
DB_PASSWORD=

# JWT - thay bang khoa rieng khi tao file .env
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# EMAIL / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-email@gmail.com

# FRONTEND / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# THONG TIN LIEN HE QUAN TRI
ADMIN_CONTACT_PHONE=0912345678
ADMIN_CONTACT_EMAIL=your-admin-email@gmail.com
